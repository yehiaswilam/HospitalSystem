@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-list-check text-primary"></i> Booked Appointments</h2>
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Appointment</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No appointments have been booked yet.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>Patient Name</th>
                            <th>Doctor Name</th>
                            <th>Specialization</th>
                            <th>Date</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int n = 1; }
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@(n++)</td>
                                <td>@a.PatientName</td>
                                <td>@a.Doctor?.Name</td>
                                <td><span class="badge bg-info text-dark">@a.Doctor?.Specialization</span></td>
                                <td>@a.Date.ToString("dd/MM/yyyy")</td>
                                <td>@DateTime.Today.Add(a.Time).ToString("h:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
