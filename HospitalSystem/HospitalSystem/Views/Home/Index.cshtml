@{
    ViewData["Title"] = "Home";
}

<section class="hero d-flex align-items-center text-center text-white">
    <div class="container">
        <img src="~/images/icon.png" alt="logo" width="96" class="mb-3 rounded-circle bg-white p-2 shadow" />
        <h1 class="display-4 fw-bold">Welcome to Our Hospital</h1>
        <p class="lead mb-4">Book your appointment with the best doctors in a few clicks.</p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-light btn-lg px-5 shadow">
                <i class="bi bi-calendar-plus"></i> Make Appointment
            </a>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-light btn-lg px-5">
                <i class="bi bi-list-check"></i> View Appointments
            </a>
        </div>
    </div>
</section>
